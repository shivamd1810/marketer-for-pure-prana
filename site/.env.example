# Google Analytics 4 Measurement ID
# Create a GA4 property at https://analytics.google.com → Admin → Create Property
# Then get the Measurement ID from Admin → Data Streams → Web
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Amazon Attribution Tag
# Generate from https://advertising.amazon.com/attribution
# This tag is appended as ?maas=<tag> to all outbound Amazon links
PUBLIC_AMAZON_ATTRIBUTION_TAG=
