---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = "https://gopureprana.com";

// GA4 Measurement ID — replace G-XXXXXXXXXX with your actual GA4 ID
const GA4_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "G-XXXXXXXXXX";

// Amazon Attribution tag — set in env or leave empty until configured
const AMAZON_ATTRIBUTION = import.meta.env.PUBLIC_AMAZON_ATTRIBUTION_TAG || "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics 4 -->
    {GA4_ID !== "G-XXXXXXXXXX" && (
      <Fragment>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script is:inline define:vars={{ GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA4_ID, {
            send_page_view: true,
            cookie_flags: 'SameSite=None;Secure',
          });
        </script>
      </Fragment>
    )}
  </head>
  <body data-amazon-attribution={AMAZON_ATTRIBUTION}>
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">
          <span class="logo-icon">🌿</span>
          <span class="logo-text">Pure Prana</span>
        </a>
        <ul class="nav-links">
          <li><a href="/#products">Products</a></li>
          <li><a href="/#why-ayurveda">Why Ayurveda</a></li>
          <li><a href="/#about">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-brand">
          <span class="logo-icon">🌿</span>
          <span class="logo-text">Pure Prana</span>
          <p class="footer-tagline">Where ancient wisdom meets modern science</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <h4>Products</h4>
            <ul>
              <li><a href="/products/hormone-balance/">Hormone Balance</a></li>
              <li><a href="/products/brain-supplement/">Brain Supplement</a></li>
              <li><a href="/products/heart-health/">Heart Health</a></li>
              <li><a href="/products/immunity-booster/">Immunity Booster</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>More Products</h4>
            <ul>
              <li><a href="/products/power-blend/">Power Blend</a></li>
              <li><a href="/products/skin-hair-nails/">Skin, Hair & Nails</a></li>
              <li><a href="/products/weight-management/">Weight Management</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Quality</h4>
            <ul>
              <li>GMP-Certified Facility</li>
              <li>Third-Party Tested</li>
              <li>Made in the USA</li>
              <li>60-Day Guarantee</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Pure Prana Ayurvedic. All rights reserved.</p>
          <p class="disclaimer">
            *These statements have not been evaluated by the Food and Drug
            Administration. These products are not intended to diagnose, treat,
            cure, or prevent any disease.
          </p>
        </div>
      </div>
    </footer>

    <!-- Amazon outbound click tracking -->
    <script src="../scripts/tracking.js"></script>

    <style is:global>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --color-primary: #1a5c4c;
        --color-primary-dark: #0f3d32;
        --color-primary-light: #e8f5f0;
        --color-accent: #c8956c;
        --color-accent-light: #f5ece4;
        --color-text: #2d3436;
        --color-text-light: #636e72;
        --color-bg: #ffffff;
        --color-bg-warm: #faf8f5;
        --color-border: #e2e0dd;
        --color-amazon: #ff9900;
        --color-amazon-dark: #e68a00;
        --font-heading: "Playfair Display", Georgia, serif;
        --font-body: "Inter", -apple-system, sans-serif;
        --max-width: 1200px;
        --radius: 12px;
        --shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.12);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-heading);
        line-height: 1.2;
      }

      .site-header {
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border);
        z-index: 100;
      }

      .nav-container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-primary);
      }

      .logo-icon {
        font-size: 1.6rem;
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: 2rem;
      }

      .nav-links a {
        font-weight: 500;
        color: var(--color-text-light);
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: var(--color-primary);
      }

      .site-footer {
        background: var(--color-primary-dark);
        color: #fff;
        padding: 4rem 1.5rem 2rem;
      }

      .footer-container {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-brand {
        margin-bottom: 2rem;
      }

      .footer-brand .logo-text {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 700;
        margin-left: 0.5rem;
      }

      .footer-tagline {
        margin-top: 0.5rem;
        opacity: 0.8;
        font-style: italic;
      }

      .footer-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }

      .footer-col h4 {
        font-size: 0.9rem;
        font-family: var(--font-body);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
        opacity: 0.7;
      }

      .footer-col ul {
        list-style: none;
      }

      .footer-col li {
        margin-bottom: 0.5rem;
        opacity: 0.85;
        font-size: 0.95rem;
      }

      .footer-col a:hover {
        opacity: 1;
        text-decoration: underline;
      }

      .footer-bottom {
        text-align: center;
        opacity: 0.7;
        font-size: 0.85rem;
      }

      .disclaimer {
        margin-top: 1rem;
        font-size: 0.75rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
      }

      @media (max-width: 768px) {
        .nav-links {
          gap: 1rem;
          font-size: 0.9rem;
        }

        .footer-links {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 480px) {
        .nav-links {
          display: none;
        }
      }
    </style>
  </body>
</html>
