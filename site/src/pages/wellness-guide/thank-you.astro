---
import Base from "../../layouts/Base.astro";
import { products } from "../../data/products";

const featuredProducts = products.slice(0, 3);
---

<Base
  title="Thank You! | Pure Prana Ayurvedic"
  description="Your Ayurvedic Wellness Guide is on its way. Check your inbox!"
>
  <section class="thank-you-hero">
    <div class="thank-you-content">
      <div class="check-icon">&#10003;</div>
      <h1>You're In!</h1>
      <p class="thank-you-subtitle">
        Your free Ayurvedic Wellness Guide is on its way to your inbox. Check
        your email in the next few minutes.
      </p>
      <div class="next-steps">
        <h3>While You Wait...</h3>
        <div class="steps-list">
          <div class="step">
            <span class="step-number">1</span>
            <p>Check your inbox (and spam folder, just in case)</p>
          </div>
          <div class="step">
            <span class="step-number">2</span>
            <p>
              Add <strong>hello@gopureprana.com</strong> to your contacts so you
              don't miss our weekly tips
            </p>
          </div>
          <div class="step">
            <span class="step-number">3</span>
            <p>Browse our best-selling Ayurvedic supplements below</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-products">
    <div class="section-container">
      <h2>Our Best Sellers</h2>
      <p class="featured-subtitle">
        Start your Ayurvedic journey with our most popular supplements.
      </p>
      <div class="products-row">
        {
          featuredProducts.map((product) => (
            <a href={`/products/${product.slug}/`} class="featured-card">
              <span class="featured-icon">{product.icon}</span>
              <h3>{product.name}</h3>
              <p>{product.tagline}</p>
              <div class="featured-meta">
                <span class="featured-rating">
                  {"★".repeat(Math.floor(product.rating))} {product.rating}
                </span>
                <span class="featured-price">{product.price}</span>
              </div>
              <span class="featured-link">
                Learn More &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .thank-you-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-light) 0%,
      var(--color-bg-warm) 100%
    );
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .thank-you-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .check-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .thank-you-hero h1 {
    font-size: 2.5rem;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .thank-you-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .next-steps {
    background: #fff;
    border-radius: var(--radius);
    padding: 2rem;
    text-align: left;
    box-shadow: var(--shadow);
  }

  .next-steps h3 {
    font-size: 1.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .step-number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step p {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.5;
    margin-top: 0.15rem;
  }

  .featured-products {
    padding: 5rem 1.5rem;
    background: #fff;
  }

  .featured-products h2 {
    font-size: 2rem;
    color: var(--color-primary-dark);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .featured-subtitle {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 2.5rem;
  }

  .products-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--color-bg-warm);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    transition: all 0.2s;
    text-decoration: none;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .featured-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .featured-card h3 {
    font-size: 1.1rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }

  .featured-card p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 1rem;
    flex: 1;
  }

  .featured-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .featured-rating {
    color: var(--color-amazon);
  }

  .featured-price {
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .featured-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
