---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";
---

<Base
  title="Pure Prana Ayurvedic | Premium Plant-Based Supplements"
  description="Discover Pure Prana's premium Ayurvedic supplements. Plant-based formulas backed by 5,000 years of ancient wisdom and modern science. GMP-certified, third-party tested. Free shipping on Amazon."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">Ancient Wisdom, Modern Science</p>
      <h1>Premium Ayurvedic<br />Supplements</h1>
      <p class="hero-description">
        Plant-based formulas rooted in 5,000 years of Ayurvedic tradition.
        GMP-certified, third-party tested, and made in the USA.
      </p>
      <div class="hero-cta">
        <a href="#products" class="btn btn-primary">Shop Products</a>
      </div>
      <div class="hero-trust">
        <div class="trust-item">
          <strong>50,000+</strong>
          <span>Happy Customers</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong>4.8/5</strong>
          <span>Average Rating</span>
        </div>
        <div class="trust-divider"></div>
        <div class="trust-item">
          <strong>98%</strong>
          <span>Would Recommend</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-badge">GMP-Certified Facility</div>
      <div class="trust-badge">Third-Party Tested</div>
      <div class="trust-badge">Made in the USA</div>
      <div class="trust-badge">60-Day Money Back</div>
      <div class="trust-badge">Free Shipping via Amazon</div>
    </div>
  </section>

  <!-- Products Section -->
  <section id="products" class="products-section">
    <div class="section-container">
      <div class="section-header">
        <h2>Our Products</h2>
        <p>
          Each formula combines time-tested Ayurvedic herbs with clinically
          studied ingredients for results you can feel.
        </p>
      </div>
      <div class="products-grid">
        {
          products.map((product) => (
            <ProductCard
              slug={product.slug}
              name={product.name}
              tagline={product.tagline}
              category={product.category}
              price={product.price}
              rating={product.rating}
              reviews={product.reviews}
              icon={product.icon}
              amazonUrl={product.amazonUrl}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Ayurveda Section -->
  <section id="why-ayurveda" class="why-section">
    <div class="section-container">
      <div class="section-header">
        <h2>Why Ayurveda?</h2>
        <p>
          Ayurveda is the world's oldest holistic healing system, originating
          over 5,000 years ago in India. Here's why millions are turning to
          Ayurvedic wellness.
        </p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">🌱</div>
          <h3>Plant-Based & Natural</h3>
          <p>
            Every ingredient comes from nature. No synthetic fillers, no
            artificial additives, no harsh chemicals. Just pure botanical power.
          </p>
        </div>
        <div class="why-card">
          <div class="why-icon">🔬</div>
          <h3>Clinically Studied</h3>
          <p>
            Our formulas are backed by 15+ clinical studies. Ancient herbs
            validated by modern science for proven efficacy.
          </p>
        </div>
        <div class="why-card">
          <div class="why-icon">⚖️</div>
          <h3>Holistic Balance</h3>
          <p>
            Ayurveda treats the root cause, not just symptoms. Our supplements
            work with your body's natural intelligence to restore balance.
          </p>
        </div>
        <div class="why-card">
          <div class="why-icon">🏭</div>
          <h3>Pharmaceutical-Grade Quality</h3>
          <p>
            Manufactured in a GMP-certified, FDA-registered facility in
            California. Every batch is third-party tested for purity and
            potency.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about-section">
    <div class="section-container">
      <div class="about-content">
        <h2>About Pure Prana</h2>
        <p>
          Pure Prana was born from a simple belief: everyone deserves access to
          the healing power of Ayurveda, backed by the rigor of modern science.
        </p>
        <p>
          We source the finest botanical ingredients, manufacture to
          pharmaceutical-grade standards in our California facility, and
          third-party test every batch. The result? Supplements you can trust to
          deliver real results.
        </p>
        <p>
          With over 50,000 happy customers and a 4.8-star average rating, Pure
          Prana is the trusted choice for Ayurvedic wellness.
        </p>
        <a href="#products" class="btn btn-primary">Explore Our Products</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-warm) 50%, var(--color-accent-light) 100%);
    padding: 6rem 1.5rem 5rem;
    text-align: center;
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-size: 3.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 1.5rem;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
    max-width: 550px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 2.2rem;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 100px;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(26, 92, 76, 0.3);
  }

  .hero-trust {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .trust-item {
    text-align: center;
  }

  .trust-item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--color-primary-dark);
    font-family: var(--font-heading);
  }

  .trust-item span {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .trust-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .trust-bar {
    background: var(--color-primary-dark);
    padding: 1rem 1.5rem;
    overflow: hidden;
  }

  .trust-bar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }

  .trust-badge {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0.9;
  }

  .section-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 2.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.05rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  .products-section {
    padding: 5rem 0;
    background: var(--color-bg-warm);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .why-section {
    padding: 5rem 0;
    background: #fff;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .why-card {
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: var(--radius);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
  }

  .why-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .why-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary-dark);
  }

  .why-card p {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  .about-section {
    padding: 5rem 0;
    background: var(--color-primary-light);
  }

  .about-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .about-content h2 {
    font-size: 2.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 1.5rem;
  }

  .about-content p {
    color: var(--color-text-light);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .about-content .btn {
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 1.5rem 3rem;
    }

    .hero h1 {
      font-size: 2.2rem;
    }

    .hero-trust {
      flex-direction: column;
      gap: 1rem;
    }

    .trust-divider {
      display: none;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
