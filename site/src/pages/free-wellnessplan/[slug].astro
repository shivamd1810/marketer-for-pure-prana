---
import Base from "../../layouts/Base.astro";
import { products } from "../../data/products";
import { plans, amazonReviewUrl } from "../../data/plans";

// Pre-rendered 30-Day Ritual Plan pages — one per product.
// This is what the QR landing page delivers the moment an email is submitted.

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const plan = plans[product.slug];
const crossSell = products.find((p) => p.slug === plan.crossSellSlug);
const reviewUrl = amazonReviewUrl(product.amazonAsin);
---

<Base
  title={`Your ${product.name} 30-Day Ritual Plan | Pure Prana Ayurvedic`}
  description={`The exact 30-day plan for ${product.name}: dosing, timing, weekly roadmap, and the habits that support ${plan.outcome}.`}
>
  <article class="plan">
    <header class="plan-hero">
      <span class="plan-icon">{product.icon}</span>
      <h1>Your {product.name} 30-Day Ritual Plan</h1>
      <p class="plan-intro">
        This is yours to keep — tap <strong>Save / Print as PDF</strong> below,
        or just bookmark this page. Welcome to Pure Prana.
      </p>
      <button class="plan-print btn-print" type="button">⬇ Save / Print as PDF</button>
    </header>

    <div class="plan-body">
      <section class="plan-card">
        <h2><span class="plan-num">1</span> How to take it</h2>
        <p>{plan.dosing}</p>
      </section>

      <section class="plan-card">
        <h2><span class="plan-num">2</span> Your 30-day roadmap</h2>
        <ul class="plan-roadmap">
          {plan.roadmap.map((stage) => (
            <li>
              <strong>{stage.period}</strong>
              <span>{stage.guidance}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="plan-card">
        <h2><span class="plan-num">3</span> Amplify it — 3 daily habits</h2>
        <ul class="plan-list">
          {plan.pairings.map((pairing) => (
            <li>{pairing}</li>
          ))}
        </ul>
      </section>

      <section class="plan-card">
        <h2><span class="plan-num">4</span> The 5 bottle-wasting mistakes</h2>
        <ul class="plan-list plan-list--warn">
          {plan.mistakes.map((mistake) => (
            <li>{mistake}</li>
          ))}
        </ul>
      </section>

      <section class="plan-card">
        <h2><span class="plan-num">5</span> Do / Avoid</h2>
        <p>
          <strong>Do</strong> stay consistent — that's the whole plan.
          <strong>Avoid</strong> guessing: consult your healthcare provider if
          you're pregnant, nursing, or taking medication.
        </p>
      </section>
    </div>

    <!-- Second yes #1 — honest review nudge (post-value, zero incentive) -->
    <section class="plan-extra plan-review">
      <h3>One quick favor — totally optional</h3>
      <p>
        If your blend is working out, an honest review on Amazon genuinely helps
        a small family brand like ours, and helps the next person find us. No
        strings, no discount attached — the plan above is yours either way.
      </p>
      <p class="plan-review-actions">
        Already love it?
        <a href={reviewUrl} target="_blank" rel="noopener" class="plan-review-link">Leave an honest review →</a>
        <br />
        <span class="plan-review-alt">Not sure yet? Follow the plan first.</span>
      </p>
    </section>

    <!-- Second yes #2 — adjacent cross-sell -->
    {crossSell && (
      <section class="plan-extra plan-crosssell">
        <h3>People taking {product.name} often reach for this next</h3>
        <a href={crossSell.amazonUrl} target="_blank" rel="noopener" class="plan-crosssell-card">
          <span class="plan-crosssell-icon">{crossSell.icon}</span>
          <span class="plan-crosssell-info">
            <strong>{crossSell.name}</strong>
            <span>{plan.crossSellReason}</span>
          </span>
          <span class="plan-crosssell-cta">See it on Amazon →</span>
        </a>
      </section>
    )}

    <section class="plan-extra plan-bonus">
      <p>
        Want the bigger picture?
        <a href="/wellness-guide/">Get our free 15-page Ayurvedic Wellness Guide →</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .plan-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-light) 0%,
      var(--color-bg-warm) 100%
    );
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .plan-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .plan-hero h1 {
    font-size: 1.9rem;
    color: var(--color-primary-dark);
    max-width: 560px;
    margin: 0 auto 0.75rem;
  }

  .plan-intro {
    color: var(--color-text-light);
    max-width: 480px;
    margin: 0 auto 1.5rem;
  }

  .plan-print {
    padding: 0.8rem 1.6rem;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .plan-print:hover {
    background: var(--color-primary-dark);
  }

  .plan-body {
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .plan-card {
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .plan-card h2 {
    font-size: 1.15rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .plan-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .plan-card p {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .plan-roadmap {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plan-roadmap li {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .plan-roadmap strong {
    color: var(--color-primary);
  }

  .plan-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .plan-list li::before {
    content: "✓ ";
    color: var(--color-primary);
    font-weight: 700;
  }

  .plan-list--warn li::before {
    content: "✗ ";
    color: #c0392b;
  }

  .plan-extra {
    max-width: 640px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }

  .plan-review {
    border-top: 1px solid var(--color-border);
    margin-top: 1.5rem;
    padding-top: 2rem;
  }

  .plan-extra h3 {
    font-size: 1.1rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .plan-extra p {
    font-size: 0.92rem;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .plan-review-actions {
    margin-top: 0.75rem;
  }

  .plan-review-link {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
  }

  .plan-review-alt {
    font-size: 0.85rem;
  }

  .plan-crosssell-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    margin-top: 0.75rem;
    transition: all 0.2s;
  }

  .plan-crosssell-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .plan-crosssell-icon {
    font-size: 1.8rem;
  }

  .plan-crosssell-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .plan-crosssell-info strong {
    color: var(--color-primary-dark);
  }

  .plan-crosssell-info span {
    color: var(--color-text-light);
    font-size: 0.85rem;
  }

  .plan-crosssell-cta {
    color: var(--color-amazon-dark);
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .plan-bonus {
    text-align: center;
    padding-bottom: 3rem;
  }

  .plan-bonus a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  /* Print: just the plan, clean */
  @media print {
    :global(.site-header),
    :global(.site-footer),
    .plan-print,
    .plan-review,
    .plan-crosssell,
    .plan-bonus {
      display: none !important;
    }

    .plan-card {
      break-inside: avoid;
      border: 1px solid #ccc;
    }
  }

  @media (max-width: 480px) {
    .plan-hero h1 {
      font-size: 1.5rem;
    }

    .plan-crosssell-card {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  document.querySelectorAll(".btn-print").forEach((btn) => {
    btn.addEventListener("click", () => window.print());
  });
</script>
