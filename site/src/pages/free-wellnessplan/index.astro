---
import Base from "../../layouts/Base.astro";
import { products } from "../../data/products";

// QR landing page — every bottle's QR points here.
// Two-step flow: step 1 captures email (the only typed field),
// step 2 asks which blend they bought and routes to its plan page.
// A valid ?p=<slug> (future label prints) personalizes step 1 and skips step 2.

const validSlugs = products.map((p) => p.slug);
const productNames = Object.fromEntries(products.map((p) => [p.slug, p.name]));
const totalReviews = products.reduce((sum, p) => sum + p.reviews, 0);
---

<Base
  title="Your Free 30-Day Ritual Plan | Pure Prana Ayurvedic"
  description="Get the exact 30-day plan for the Pure Prana blend you bought — dosing, timing, and the habits that make it work. Free, opens instantly."
>
  <!-- STEP 1 — email capture (the entire 5-second decision) -->
  <section class="wp-hero step1-only">
    <div class="wp-hero-content">
      <p class="wp-eyebrow">Thanks for choosing Pure Prana 🌿</p>
      <h1 class="wp-h1" id="wp-headline">Your free 30-Day Plan is ready.</h1>
      <p class="wp-subhead">
        Most supplements quietly fail for one reason — people take them wrong,
        or quit before they kick in. Here's the exact 30-day plan for the blend
        in your hand: when to take it, what to expect each week, and the small
        habits that make it work. Yours free, opens instantly.
      </p>

      <form class="wp-form" data-location="hero">
        <p class="wp-hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <input
          type="email"
          name="email"
          placeholder="Enter your email address"
          required
          aria-label="Email address"
          class="wp-input"
        />
        <button type="submit" class="wp-button" data-cta>Get My Free Plan →</button>
        <p class="wp-microtrust">
          Opens instantly on the next screen · 4.7★ from {totalReviews}+ buyers · We'll never sell your email.
        </p>
        <p class="wp-consent">
          By subscribing, you agree to receive emails from Pure Prana Ayurvedic.
          Unsubscribe anytime. We respect your privacy and will never share your information.
        </p>
      </form>
    </div>
  </section>

  <!-- STEP 2 — product picker (shown after email is captured) -->
  <section class="wp-step2" id="wp-step2" hidden>
    <div class="wp-step2-content">
      <div class="wp-check">✓</div>
      <h2>You're in. One last tap —</h2>
      <p class="wp-step2-sub">Which blend is in your hand? We'll open its exact plan.</p>
      <div class="wp-picker">
        {products.map((product) => (
          <button class="wp-picker-card" data-slug={product.slug} type="button">
            <span class="wp-picker-icon">{product.icon}</span>
            <span class="wp-picker-name">{product.name}</span>
            <span class="wp-picker-tagline">{product.tagline}</span>
          </button>
        ))}
      </div>
      <a href="/free-wellnessplan/start/" class="wp-skip">Not sure / skip → see the general plan</a>
    </div>
  </section>

  <!-- B — value stack -->
  <section class="wp-section step1-only">
    <div class="wp-container">
      <h2>What's in your 30-Day Plan</h2>
      <ul class="wp-stack">
        <li>🕐 <strong>Exact dosing &amp; timing</strong> — how many, when, and the food trick most people miss for absorption</li>
        <li>📅 <strong>Your day-by-day roadmap</strong> — what to notice in Days 1–3, Week 1, and Weeks 2–4 so you don't quit too early</li>
        <li>🔗 <strong>3 daily habits</strong> that make your blend work harder — free, two minutes each</li>
        <li>⚠️ <strong>The 5 mistakes that waste a whole bottle</strong> — and how to avoid every one</li>
      </ul>
      <p class="wp-stack-subline">One page. Built for the exact bottle you're holding. Not a generic handout.</p>
    </div>
  </section>

  <!-- C — sunk cost -->
  <section class="wp-section wp-section--warm step1-only">
    <div class="wp-container">
      <h3>You already paid for the bottle.</h3>
      <p>
        Taking it wrong — empty stomach, skipped days, quitting at day five — is
        the difference between a bottle that does nothing and one that earns its
        place in your routine. This plan makes sure you get every dollar of what
        you already bought. A one-on-one Ayurvedic consult runs $75+. Yours is
        free, because you're already a customer.
      </p>
    </div>
  </section>

  <!-- D — trust strip -->
  <section class="wp-trust step1-only">
    <span>🌿 Rooted in 5,000 years of Ayurveda</span>
    <span>🔬 Third-party tested, GMP-certified facility</span>
    <span>👥 Trusted by 5,000+ customers</span>
    <span>🔒 Your email stays private</span>
  </section>

  <!-- E — repeat CTA -->
  <section class="wp-section step1-only">
    <div class="wp-container wp-repeat">
      <h3>Get your plan now — it's free.</h3>
      <form class="wp-form" data-location="repeat">
        <p class="wp-hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <input
          type="email"
          name="email"
          placeholder="Enter your email address"
          required
          aria-label="Email address"
          class="wp-input"
        />
        <button type="submit" class="wp-button" data-cta>Get My Free Plan →</button>
      </form>
    </div>
  </section>

  <!-- F — FAQ -->
  <section class="wp-section wp-section--warm step1-only">
    <div class="wp-container">
      <h3>Quick questions</h3>
      <dl class="wp-faq">
        <dt>Is this really free?</dt>
        <dd>Yes — it's our thank-you for buying. No purchase of anything else required.</dd>
        <dt>Will you spam me?</dt>
        <dd>No. You'll get your plan and occasional Ayurvedic tips. Unsubscribe in one tap.</dd>
        <dt>I bought a different Pure Prana blend.</dt>
        <dd>No problem — after you enter your email, you'll pick your exact blend and get its matching plan.</dd>
        <dt>Do I need an app or login?</dt>
        <dd>No. Enter your email, pick your blend, and your plan opens on the next screen.</dd>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* Kill the sticky nav on this page — nothing competes with the form. */
  :global(.site-header) {
    display: none;
  }

  .wp-hidden {
    display: none !important;
  }

  .wp-hero {
    background: linear-gradient(
      135deg,
      var(--color-primary-light) 0%,
      var(--color-bg-warm) 50%,
      var(--color-accent-light) 100%
    );
    padding: 3rem 1.5rem 3.5rem;
  }

  .wp-hero-content {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .wp-eyebrow {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .wp-h1 {
    font-size: 2.1rem;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .wp-subhead {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .wp-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 420px;
    margin: 0 auto;
  }

  .wp-input {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-family: var(--font-body);
    font-size: 1rem;
    text-align: center;
    outline: none;
    transition: border-color 0.2s;
  }

  .wp-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(26, 92, 76, 0.1);
  }

  .wp-button {
    padding: 0.95rem 1.5rem;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: 100px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .wp-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(26, 92, 76, 0.3);
  }

  .wp-button:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
  }

  .wp-microtrust {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin-top: 0.25rem;
  }

  .wp-consent {
    font-size: 0.72rem;
    color: var(--color-text-light);
    line-height: 1.4;
  }

  /* Step 2 */
  .wp-step2 {
    background: linear-gradient(
      135deg,
      var(--color-primary-light) 0%,
      var(--color-bg-warm) 100%
    );
    padding: 3rem 1.5rem 4rem;
  }

  .wp-step2-content {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .wp-check {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .wp-step2 h2 {
    font-size: 1.8rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .wp-step2-sub {
    color: var(--color-text-light);
    margin-bottom: 1.75rem;
  }

  .wp-picker {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .wp-picker-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1.1rem 0.75rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.15s;
  }

  .wp-picker-card:hover,
  .wp-picker-card:focus {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .wp-picker-icon {
    font-size: 1.6rem;
  }

  .wp-picker-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-primary-dark);
  }

  .wp-picker-tagline {
    font-size: 0.75rem;
    color: var(--color-text-light);
    line-height: 1.3;
  }

  .wp-skip {
    font-size: 0.85rem;
    color: var(--color-text-light);
    text-decoration: underline;
  }

  /* Content sections */
  .wp-section {
    padding: 2.75rem 1.5rem;
  }

  .wp-section--warm {
    background: var(--color-bg-warm);
  }

  .wp-container {
    max-width: 560px;
    margin: 0 auto;
  }

  .wp-section h2,
  .wp-section h3 {
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .wp-stack {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .wp-stack li {
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .wp-stack-subline {
    margin-top: 1rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--color-text-light);
  }

  .wp-section p {
    color: var(--color-text);
    line-height: 1.65;
  }

  .wp-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    padding: 1.5rem;
    background: var(--color-primary-dark);
    color: #fff;
    font-size: 0.85rem;
  }

  .wp-repeat {
    text-align: center;
  }

  .wp-faq dt {
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-top: 1rem;
  }

  .wp-faq dd {
    margin: 0.25rem 0 0;
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* Step-2 active state: hide everything else */
  :global(body.wp-step2-active) .step1-only {
    display: none;
  }

  @media (max-width: 480px) {
    .wp-h1 {
      font-size: 1.7rem;
    }

    .wp-hero {
      padding-top: 2rem;
    }

    .wp-picker {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script define:vars={{ validSlugs, productNames }}>
  const params = new URLSearchParams(window.location.search);
  const qrSlug = validSlugs.includes(params.get("p")) ? params.get("p") : null;
  let capturedEmail = sessionStorage.getItem("wp-email") || "";

  // Personalize when the QR already told us the product (?p=<slug>)
  if (qrSlug) {
    const name = productNames[qrSlug];
    document.getElementById("wp-headline").textContent =
      `You bought ${name}. Now make it actually work.`;
    document.querySelectorAll("[data-cta]").forEach((btn) => {
      btn.textContent = `Send My ${name} Plan →`;
    });
  }

  // Best-effort capture: never block the promised plan on this succeeding.
  function capture(email, product, source) {
    try {
      return fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, product, source }),
        keepalive: true,
      }).catch(() => {});
    } catch {
      return Promise.resolve();
    }
  }

  function track(label) {
    if (typeof window.gtag === "function") {
      window.gtag("event", "wellnessplan_unlock", {
        event_category: "engagement",
        event_label: label,
        value: 1,
      });
    }
  }

  // STEP 1 — email submit (hero + repeat forms share this handler)
  document.querySelectorAll(".wp-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const botField = form.querySelector('input[name="bot-field"]');
      if (botField && botField.value) return; // honeypot

      const email = form.querySelector('input[name="email"]').value.trim();
      if (!email) return;

      const button = form.querySelector(".wp-button");
      button.disabled = true;
      button.textContent = "Opening your plan…";

      capturedEmail = email;
      sessionStorage.setItem("wp-email", email);
      track(qrSlug || "unknown");

      const post = capture(email, qrSlug || "unknown", "qr-wellnessplan");

      if (qrSlug) {
        // QR already knows the product — straight to the plan.
        await Promise.race([post, new Promise((r) => setTimeout(r, 1500))]);
        window.location.href = `/free-wellnessplan/${qrSlug}/`;
        return;
      }

      // Otherwise show step 2 (email is already saved either way).
      document.body.classList.add("wp-step2-active");
      document.getElementById("wp-step2").hidden = false;
      window.scrollTo({ top: 0, behavior: "instant" });
    });
  });

  // STEP 2 — product pick: update the record, open the plan.
  document.querySelectorAll(".wp-picker-card").forEach((card) => {
    card.addEventListener("click", () => {
      const slug = card.dataset.slug;
      track(slug);
      // keepalive lets this POST survive the navigation — no await needed.
      capture(capturedEmail, slug, "qr-wellnessplan-product");
      window.location.href = `/free-wellnessplan/${slug}/`;
    });
  });
</script>
